# Safesports Panel Integration
SAFESPORTS_PANEL_URL=https://safesports-panel.vercel.app

# Opción 1: API Secret de admin (para importación masiva)
# Este secret debe coincidir con IMPORT_API_SECRET en safesports-panel
IMPORT_API_SECRET=your-super-secret-key-here

# Opción 2: API Key de usuario (genera desde el panel en tu perfil)
# Preferido para usuarios individuales
SAFESPORTS_USER_API_KEY=sk_your-api-key-here

# Opción 3: Credenciales de usuario (genera API key automáticamente)
# El script obtendra la API key usando estas credenciales
SAFESPORTS_PANEL_EMAIL=tu-email@ejemplo.com
SAFESPORTS_PANEL_PASSWORD=tu-password

# Generate a secret with:
# openssl rand -hex 32
